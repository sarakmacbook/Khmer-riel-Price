# ---------------------------------------------------------------------------
# Wing Bank KHR/USD tracker — example environment
# Copy to .env (or set these in your host's dashboard). Nothing here is required:
# with no variables at all the app serves the live rate from memory.
# ---------------------------------------------------------------------------

# Primary database (any ONE of these backends; auto-detected)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db
# TURSO_DATABASE_URL=libsql://my-db-org.turso.io
# TURSO_AUTH_TOKEN=
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/wingrate
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=rediss://default:password@host:6379
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx_yyyyyyyy
# STORAGE=postgres            # force one backend instead of auto-detecting

# ---------------------------------------------------------------------------
# Backup database + failover (optional) — see README "🔗 Backup database"
# ---------------------------------------------------------------------------
# A second database of any supported kind. Every write is mirrored into it, it
# takes over if the primary stops answering, and the app returns to the primary
# automatically (rows recorded during the outage are copied back).
#
# Either describe it with env vars — any BACKUP_/SECONDARY_/REPLICA_/FALLBACK_
# prefixed name works (the prefix keeps it out of primary detection):
# BACKUP_DATABASE_URL=postgresql://user:password@ep-backup.eu-central-1.aws.neon.tech/backup
# SECONDARY_TURSO_DATABASE_URL=libsql://my-backup-org.turso.io
# SECONDARY_TURSO_AUTH_TOKEN=
# FALLBACK_MONGODB_URI=mongodb+srv://user:password@backup.mongodb.net/wingrate
# BACKUP_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_backupstore_zzzzzzzz
#
# …or inline (read-only filesystems / serverless):
# DB_BACKUP_JSON={"kind":"postgres","url":"postgresql://user:password@host:5432/backup","options":{"mirror":true}}

# Link behaviour (defaults shown; set 0/false to switch one off)
# LINK_MIRROR=1             # write to both databases
# LINK_AUTO_FAILOVER=1      # serve from the backup when the primary is down
# LINK_AUTO_RETURN=1        # go back to the primary once it answers again
# LINK_AUTO_RESYNC=1        # copy failover rows back into the primary
# LINK_PROBE_SECONDS=30     # how often a failed primary is re-checked
# LINK_COPY_LIMIT=20000     # max history rows per manual copy
# LINK_RESYNC_LIMIT=5000    # max history rows per automatic catch-up
# LINK_MAX_LAG_SECONDS=900  # when the cron repairs a lagging backup

# ---------------------------------------------------------------------------
# Telegram bot / alerts
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_ADMIN_CHAT_ID=123456789      # the only chat allowed to run /database
# TELEGRAM_WEBHOOK_SECRET=              # register with setWebhook&secret_token=…
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Runtime database menu + HTTP management
# ---------------------------------------------------------------------------
# DB_CONFIG_FILE=./.data/wingrate-db.json
# DB_CONFIG_JSON={"mode":"custom","spec":{...}}   # pin a choice on read-only filesystems
# ADMIN_SECRET=            # required by POST/DELETE /api/database and /api/database/link
# CRON_SECRET=             # protects /api/cron/update-rate (and works as the admin secret)
